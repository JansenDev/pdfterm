#!/usr/bin/env bash
# pdfterm — lector de PDF en la terminal, con formato de lectura ajustable.
set -uo pipefail

CACHE="$HOME/.local/share/pdfterm"; CONF="$HOME/.config/pdfterm"
mkdir -p "$CACHE" "$CONF"; RCF="$CONF/config"

# --- Preferencias de lectura (se guardan en ~/.config/pdfterm/config) --------
ANCHO=64          # ancho de la columna de texto, en caracteres
INTER=1           # líneas en blanco entre renglones
PARRAFO=3         # líneas en blanco entre párrafos (total, no extra)
NUM=1             # numerar los renglones a la izquierda
TEMA=suave        # suave | sepia | normal | propio
CABECERA=completa # completa | compacta | minima | oculta
COLOR_TEXTO=252   # solo si TEMA=propio
COLOR_TITULO=117
COLOR_NUM=240
GUIA=0            # guia de lectura por defecto, para libros sin estado propio
GUIA_ESTILO=linea # linea = se pinta el renglon entero; marca = solo numero y flecha
IMG_FORMATO=auto  # auto | sixels | kitty | iterm | symbols
IMG_DPI=200       # resolucion a la que se extrae la pagina para dibujarla
CURSIVA=1         # mostrar en cursiva lo que el PDF marca asi
COMILLAS=0        # ademas, encerrar entre comillas lo que va en cursiva
RATON=1           # el raton marca el renglon donde haces clic
COLOR_MARCA=214   # color del renglon marcado
[ -f "$RCF" ] && . "$RCF"

CONF_SUCIO=0
# Los ajustes marcan la configuracion como pendiente en vez de escribirla: si
# se mantiene pulsada una tecla como > o +, reescribir el fichero entero en
# cada repeticion es trabajo tirado. Se vuelca cuando se deja de pulsar.
marcar_conf() { CONF_SUCIO=1; }
volcar_conf() { [ "$CONF_SUCIO" -eq 1 ] && { guardar_conf; CONF_SUCIO=0; }; return 0; }

guardar_conf() {
  cat > "$RCF" <<EOF
# Configuración de pdfterm. Se puede editar a mano; también se actualiza
# sola cuando cambias algo con las teclas dentro del lector.
# Para abrirla rápido:  pdfterm --config

# ---- Formato del texto -----------------------------------------------------

# Ancho de la columna de texto, en caracteres. Entre 40 y 120.
# Cuanto más estrecha, más cómoda de leer; 60-70 es lo habitual en un libro.
ANCHO=$ANCHO

# Líneas en blanco entre renglón y renglón (el interlineado).
# 0 = compacto, 1 = espaciado, 2-3 = muy aireado.
INTER=$INTER

# Líneas en blanco entre un párrafo y el siguiente. Es el total, no un extra
# sobre INTER. Ponlo mayor que INTER para que los párrafos se distingan.
PARRAFO=$PARRAFO

# Numeración de renglones en el margen izquierdo. 1 = sí, 0 = no.
# Los números se reinician en cada página.
NUM=$NUM

# ---- Aspecto ---------------------------------------------------------------

# Barra superior:
#   completa  nombre del libro entero + línea de ajustes debajo
#   compacta  todo en una línea, con el nombre recortado
#   minima    solo nombre y número de página
#   oculta    sin barra, únicamente el texto
CABECERA=$CABECERA

# Colores: suave (gris claro), sepia (cálido, tipo papel),
# normal (sin color, usa el del terminal), propio (usa los tres de abajo).
TEMA=$TEMA

# Respetar las cursivas del documento. pdftotext las descarta, asi que hay que
# extraer con pdftohtml, que marca el texto en cursiva; cuesta unos 130 ms mas
# por pagina, solo al cambiarla. Con 0 se usa pdftotext y se pierde el estilo.
# Se alterna con la tecla c.
CURSIVA=$CURSIVA

# Encerrar entre comillas dobles los tramos en cursiva. Util cuando el libro
# usa la cursiva para lo que piensa o dice el personaje. Es independiente de
# CURSIVA: se pueden tener las comillas sin que el texto se vea en cursiva, y
# al reves. Se alterna con la tecla C.
COMILLAS=$COMILLAS

# ---- Ilustraciones ---------------------------------------------------------

# Como se dibujan las imagenes en la terminal. auto deja que chafa lo decida,
# pero no siempre acierta: en Windows Terminal 1.22 o superior, kitty, WezTerm
# e iTerm2 conviene forzar el formato para tener calidad de verdad.
#   sixels   graficos reales, la mejor opcion si el terminal los soporta
#   kitty    protocolo de kitty
#   iterm    protocolo de iTerm2
#   symbols  arte con caracteres, funciona en cualquier terminal pero se ve tosco
IMG_FORMATO=$IMG_FORMATO

# Resolucion en puntos por pulgada a la que se extrae la pagina antes de
# dibujarla. Mas alto da mas detalle y tarda un poco mas.
IMG_DPI=$IMG_DPI

# Colores propios, solo se aplican con TEMA=propio.
# Son números de la paleta de 256 del terminal. Para verlos todos:
#   for i in \$(seq 0 255); do printf "\\e[38;5;\${i}m%3d \\e[0m" \$i; done; echo
COLOR_TEXTO=$COLOR_TEXTO
COLOR_TITULO=$COLOR_TITULO
COLOR_NUM=$COLOR_NUM

# ---- Seguimiento de lectura ------------------------------------------------

# Guia de lectura (tecla l): 1 = encendida, 0 = apagada. Este es el valor por
# defecto, el que se aplica a un libro que abres por primera vez. Cada libro
# recuerda ademas el suyo en ~/.local/share/pdfterm/, y ese manda sobre este.
GUIA=$GUIA

# Como se resalta el renglon de la guia (tecla L):
#   linea  se pinta el renglon entero con el color de la marca
#   marca  se pinta solo el numero y la flecha, y el texto queda como el resto
GUIA_ESTILO=$GUIA_ESTILO


# Marca de lectura con el raton. 1 = un clic marca el renglon donde pinchas,
# 0 = el raton se comporta como siempre y puedes seleccionar texto.
# Dentro del lector se alterna con la tecla r; con el raton activo, para
# seleccionar texto hay que mantener Shift mientras arrastras.
RATON=$RATON

# Color del renglon marcado, de la paleta de 256.
COLOR_MARCA=$COLOR_MARCA
EOF
}
grep -q '^COMILLAS=' "$RCF" 2>/dev/null || guardar_conf   # crea o migra el fichero

# --- pdfterm --config: abrir la configuración en el editor ------------------
if [ "${1:-}" = "--config" ] || [ "${1:-}" = "-c" ]; then
  exec "${EDITOR:-nano}" "$RCF"
fi

F="${1:-}"
[ -z "$F" ] && { echo "Uso: pdfterm archivo.pdf [página]   ·   pdfterm --config"; exit 1; }
[ -f "$F" ] || { echo "No existe: $F"; exit 1; }
command -v pdftotext >/dev/null || { echo "Falta poppler-utils"; exit 1; }

ID=$(readlink -f "$F" | md5sum | cut -d' ' -f1)
POSF="$CACHE/$ID.pos"; HDRF="$CACHE/$ID.hdr"; TXTF="$CACHE/$ID.txt"
IMGF="$CACHE/$ID.img"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
LIBRO=$(basename "$F" | sed -E 's/\.[Pp][Dd][Ff]$//')

AYUDA_IMG='[espacio]sig [p]ant [i]grande [I]lista [F]formato [h]cab [q]salir'
AYUDA='[espacio]sig [p]ant [j/k o rueda]mover [clic]marcar [l]guía [L]estilo [g]ir [/]buscar [i/I]magen [F]formato [c]cursiva [C]comillas · [+/-]inter [./,]parr [</>]ancho [#/0]num [t]ema [h]cab [r]raton [q]salir'

# Tamaño de la celda del terminal en pixeles. chafa lo necesita para dibujar a
# tamaño real, pero ConPTY no lo informa por ioctl, asi que se le pregunta al
# terminal con CSI 16 t. Si no contesta se usa 8x8, que es lo que chafa asume.
CELDA_W=8; CELDA_H=8

# Descarta lo que quede sin leer en la entrada. Imprescindible tras preguntarle
# algo al terminal: si su respuesta llega tarde y no se consume, sus bytes se
# leen despues como teclas sueltas y disparan comandos ('0' alterna los
# numeros, 't' cambia el tema), con lo que la pantalla se descuadra sola.
drenar_entrada() {
  local basura
  while IFS= read -rsn1 -t 0.02 basura 2>/dev/null; do :; done
  return 0
}

consultar_celda() {
  local resp
  [ -t 1 ] || return 1
  printf '\033[16t' > /dev/tty 2>/dev/null || return 1
  IFS= read -rsd t -t 0.5 resp < /dev/tty 2>/dev/null || { drenar_entrada; return 1; }
  resp="${resp#*[}"                       # "6;20;10"
  case "$resp" in 6\;*) ;; *) return 1 ;; esac
  resp="${resp#6;}"
  local h="${resp%%;*}" w="${resp##*;}"
  [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || return 1
  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
  CELDA_W=$w; CELDA_H=$h
}

# El tamaño del terminal se mide una vez y se recalcula solo al redimensionar.
# Cada tput cuesta un milisegundo, y con la rueda se repinta muchas veces
# seguidas: consultarlo en cada repintado era la mitad del trabajo.
# tput protesta si no hay TERM (contenedores, cron); se asume un tamaño normal.
COLS=80; LINEAS=24
medir_terminal() {
  local t
  # stty contra /dev/tty es fiable aunque la entrada este redirigida; tput
  # se queda con el valor de terminfo (24x80) en cuanto stdin no es el terminal.
  if t=$(stty size </dev/tty 2>/dev/null) && [ -n "$t" ]; then
    LINEAS="${t%% *}"; COLS="${t##* }"
  else
    COLS=$(tput cols  2>/dev/null) || COLS=80
    LINEAS=$(tput lines 2>/dev/null) || LINEAS=24
  fi
  [ "${COLS:-0}" -gt 0 ] || COLS=80
  [ "${LINEAS:-0}" -gt 0 ] || LINEAS=24
}
medir_terminal
trap medir_terminal WINCH

paleta() {
  case "$TEMA" in
    sepia)  C_TXT=$'\033[38;5;223m'; C_TIT=$'\033[1;38;5;215m'; C_NUM=$'\033[38;5;101m' ;;
    normal) C_TXT='';                C_TIT=$'\033[1m';          C_NUM=$'\033[2m' ;;
    propio) C_TXT=$'\033[38;5;'"$COLOR_TEXTO"'m'; C_TIT=$'\033[1;38;5;'"$COLOR_TITULO"'m'
            C_NUM=$'\033[38;5;'"$COLOR_NUM"'m' ;;
    *)      C_TXT=$'\033[38;5;252m'; C_TIT=$'\033[1;38;5;117m'; C_NUM=$'\033[38;5;240m' ;;
  esac
  C_MRK=$'\033[1;38;5;'"$COLOR_MARCA"'m'
  C_OFF=$'\033[0m'
}

TOTAL=$(pdfinfo "$F" 2>/dev/null | awk '/^Pages:/{print $2}')
[ -z "$TOTAL" ] && { echo "No se pudo leer el PDF"; exit 1; }
# La posicion guardada por libro es "pagina renglon guia". Si el fichero es
# antiguo y solo trae dos campos, la guia toma el valor global.
GUARDADO=$( [ -f "$POSF" ] && cat "$POSF" || echo "1 1" )
read -r G_PAG G_MARCA G_GUIA <<< "$GUARDADO"
PAG="${2:-${G_PAG:-1}}"
MARCA="${G_MARCA:-1}"
GUIA="${G_GUIA:-$GUIA}"
[[ "$PAG"   =~ ^[0-9]+$ ]] || PAG=1
[[ "$MARCA" =~ ^[0-9]+$ ]] || MARCA=1
[[ "$GUIA"  =~ ^[01]$   ]] || GUIA=0
[ -n "${2:-}" ] && MARCA=1

# Texto de una pagina. Se usa pdftotext porque conserva la sangria con la que
# se distinguen los parrafos; pdftohtml posiciona cada fragmento de forma
# absoluta y esa informacion se pierde.
extraer_pagina() {
  pdftotext -layout -f "$1" -l "$1" "$F" - 2>/dev/null
}

# Fragmentos en cursiva de una pagina, uno por linea y con los espacios ya
# normalizados. pdftotext descarta el estilo, asi que hay que preguntarselo a
# pdftohtml, que si marca las cursivas con <i>.
extraer_cursivas() {
  [ "$CURSIVA" -eq 1 ] || [ "$COMILLAS" -eq 1 ] || return 0
  pdftohtml -s -noframes -i -enc UTF-8 -f "$1" -l "$1" -stdout "$F" 2>/dev/null \
    | sed '/<style/,/<\/style>/d' | tr -d '\n' \
    | grep -o '<i>[^<]*</i>' \
    | sed 's/<[^>]*>//g; s/&#160;/ /g; s/&#34;/"/g; s/&amp;/\&/g' \
    | sed 's/  */ /g; s/^ //; s/ *$//' \
    | sed 's/^[-–—[:space:]]*//; s/[-–—[:space:]]*$//' \
    | grep -E '[[:alpha:]]' | awk 'length($0) >= 2'
}

if [ ! -f "$HDRF" ]; then
  paso=$(( TOTAL / 12 )); [ "$paso" -lt 1 ] && paso=1
  for ((p=paso; p<TOTAL; p+=paso)); do
    extraer_pagina "$p"
  done | sed -E 's/[0-9]+//g; s/[[:space:]]+/ /g; s/^ //; s/ $//' \
       | grep -v '^ *$' | sort | uniq -c | sort -rn \
       | awk '$1>=6 { sub(/^[[:space:]]*[0-9]+[[:space:]]/, ""); print }' > "$HDRF"
fi

filtrar() {
  awk -v h="$HDRF" '
    BEGIN { while ((getline l < h) > 0) if (length(l)) hdr[l]=1 }
    { n=$0; gsub(/[0-9]+/,"",n); gsub(/[ \t]+/," ",n); gsub(/^ | $/,"",n)
      if (!(n in hdr)) print }'
}

recortar() { awk -v n="$1" '{ print substr($0, 1, n) }'; }

cabecera() {
  local p=$1 ajustes libro max
  max=$(( COLS - 1 ))
  libro=$(printf '%s' "$LIBRO" | recortar 38)
  if [ "$TIPO" = img ]; then
    ajustes="ilustración · ancho $ANCHO · inter $INTER · párr $PARRAFO · $TEMA"
  elif [ "$GUIA" -eq 1 ]; then
    ajustes="renglón $MARCA/$RENGLONES · ancho $ANCHO · inter $INTER · párr $PARRAFO · $TEMA"
  else
    ajustes="guía off · ancho $ANCHO · inter $INTER · párr $PARRAFO · $TEMA"
  fi
  # Con una ilustracion en pantalla, una sola linea para dejarle sitio
  if [ "$TIPO" = img ] && [ "$CABECERA" != oculta ]; then
    printf '\033[2m%s\033[0m\n' \
      "$(printf '%s · pág %d/%d · ilustración' "$libro" "$p" "$TOTAL" | cut -c1-"$(( $COLS - 1 ))")"
    return
  fi
  case "$CABECERA" in
    oculta)   : ;;
    minima)   printf '\033[2m%s\033[0m\n\n' "$(printf '%s · %d/%d' "$LIBRO" "$p" "$TOTAL" | recortar "$max")" ;;
    compacta) printf '\033[2m%s\033[0m\n' \
                     "$(printf '%s · pág %d/%d · %s' "$libro" "$p" "$TOTAL" "$ajustes" | recortar "$max")" ;;
    *)        printf '\033[1m%s\033[0m\n' "$(printf '%s' "$LIBRO" | recortar "$max")"
              printf '\033[2m%s\033[0m\n' \
                     "$(printf 'página %d de %d · %s' "$p" "$TOTAL" "$ajustes" | recortar "$max")"
              printf '\033[2m%*s\033[0m\n' "$max" '' | tr ' ' '_' ;;
  esac
}

formatear() {
  local prefw=0 marg ancho
  [ "$NUM" -eq 1 ] && prefw=6
  # En una ventana estrecha el ancho configurado no cabe: se recorta al hueco
  # disponible, o las lineas se parten y descuadran la pagina.
  ancho=$ANCHO
  [ $(( ancho + prefw + 2 )) -gt "$COLS" ] && ancho=$(( COLS - prefw - 2 ))
  [ "$ancho" -lt 20 ] && ancho=20
  marg=$(( ( COLS - ancho - prefw ) / 2 )); [ "$marg" -lt 1 ] && marg=1
  awk -v curs="$TMP/cursivas" '
    # Los tramos en cursiva llegan en un fichero aparte, ya normalizados. Se
    # buscan en el parrafo una vez unido, porque en el texto original vienen
    # partidos por los saltos de linea del PDF.
    BEGIN { while ((getline l < curs) > 0) if (length(l)) frag[++nf] = l }
    function marcar(t,   i, p) {
      for (i = 1; i <= nf; i++) {
        p = index(t, frag[i])
        if (p > 0) t = substr(t, 1, p - 1) "\001" frag[i] "\002" substr(t, p + length(frag[i]))
      }
      # Un mismo dialogo suele venir partido en varios <i> seguidos. Si dos
      # tramos solo estan separados por espacios, son uno: se fusionan para que
      # no acaben con un par de comillas cada uno.
      t = gensub(/\002( *)\001/, "\\1", "g", t)
      return t
    }
    function flush() {
      if (length(buf)) {
        gsub(/  +/, " ", buf)      # el justificado deja espacios de sobra
        print marcar(buf); print ""; buf=""
      }
    }
    /^[[:space:]]*$/       { flush(); next }
    /^[[:space:]]{2,}/     { flush(); sub(/^[[:space:]]+/,""); buf=$0; next }
                           { sub(/^[[:space:]]+/,""); sub(/[[:space:]]+$/,"")
                             buf = length(buf) ? buf " " $0 : $0 }
    END { flush() }
  ' | fmt -w "$ancho" | awk -v m="$marg" -v il="$INTER" -v pp="$PARRAFO" -v num="$NUM" \
        -v ct="$C_TXT" -v cl="$C_TIT" -v cn="$C_NUM" -v off="$C_OFF" \
        -v mapa="$TMP/mapa" -v ital="$CURSIVA" -v com="$COMILLAS" '
    # Ademas del texto escribe un mapa: por cada linea de salida, el numero de
    # renglon al que corresponde (0 si es una linea en blanco). Sirve para
    # traducir la fila donde se hace clic al renglon que hay debajo.
    BEGIN { n = 0; cur = 0
            ITAL  = ital ? "\033[3m"  : ""
            RECTO = ital ? "\033[23m" : ""
            ABRE  = com ? "\"" ITAL : ITAL          # comilla fuera de la cursiva
            CIERRA = com ? RECTO "\"" : RECTO
            printf "" > mapa }
    /^[[:space:]]*$/ { for (i = 0; i < pp - il; i++) { print ""; print 0 > mapa } next }
    {
      n++
      # Cursivas: se reabre el tramo si venia de la linea anterior
      if (cur) { $0 = ITAL $0 }
      abre = gsub(/\001/, ABRE)
      cierra = gsub(/\002/, CIERRA)
      cur = (cur + abre - cierra > 0) ? 1 : 0
      pre = num ? sprintf("%s%3d \342\224\202 " off, cn, n) : ""
      c = ($0 ~ /^(\033\[3m)?(Capítulo|Capitulo|CAPÍTULO|Prólogo|Epílogo|Parte|Volumen|Arco)/) ? cl : ct
      printf "%*s%s%s%s%s\n", m, "", pre, c, $0, off
      print n > mapa
      for (i = 0; i < il; i++) { print ""; print 0 > mapa }
    }'
}

# Ancho y alto de un PNG, leidos de su cabecera (bytes 16..23)
dims_png() {
  local b
  b=$(od -An -tu1 -j16 -N8 "$1" 2>/dev/null) || return 1
  set -- $b
  [ $# -lt 8 ] && return 1
  echo "$(( $1*16777216 + $2*65536 + $3*256 + $4 )) $(( $5*16777216 + $6*65536 + $7*256 + $8 ))"
}

# Dibuja la pagina como imagen. El segundo argumento es el alto disponible en
# filas; si no se indica, se calcula descontando cabecera y barra de ayuda.
render_img() {
  command -v chafa >/dev/null || { echo "  (instala chafa para ver las ilustraciones)"; return; }
  local alto opts=() iw ih cw ancho medida
  alto="${2:-$(( $LINEAS - $(alto_cabecera) - $(filas_ayuda) ))}"
  [ "$alto" -lt 5 ] && alto=5
  local grafico=1
  case "$IMG_FORMATO" in
    symbols) opts+=(-f symbols); grafico=0 ;;
    auto)    ;;
    *)       opts+=(-f "$IMG_FORMATO") ;;
  esac
  pdftoppm -f "$1" -l "$1" -r "$IMG_DPI" -png -singlefile "$F" "$TMP/pg" 2>/dev/null

  cw=$COLS
  medida="${cw}x${alto}"

  # Con los formatos graficos el area se calcula en pixeles, no en celdas:
  #  - se parte del espacio real disponible (celdas x tamaño de celda)
  #  - se ajusta al aspecto de la imagen, porque si se le da un area mas ancha
  #    chafa rellena el resto de fondo y aparece una franja negra al lado
  #  - se divide por 8 porque chafa cuenta 8 px por celda con --font-ratio=1/1
  #    (medido en la salida sixel, no documentado)
  # En modo symbols no aplica: dibuja con caracteres, no con pixeles.
  local px_alto px_ancho w_px h_px
  if [ "$grafico" -eq 1 ] && read -r iw ih < <(dims_png "$TMP/pg.png") \
     && [ "${ih:-0}" -gt 0 ] && [ "${iw:-0}" -gt 0 ]; then
    opts+=(--font-ratio=1/1)
    px_alto=$(( alto * CELDA_H ))
    px_ancho=$(( cw * CELDA_W ))
    if [ $(( px_alto * iw / ih )) -le "$px_ancho" ]; then
      w_px=$(( px_alto * iw / ih )); h_px=$px_alto
    else
      w_px=$px_ancho; h_px=$(( px_ancho * ih / iw ))
    fi
    medida="$(( w_px / 8 ))x$(( h_px / 8 ))"
  fi
  chafa "${opts[@]}" --size="$medida" "$TMP/pg.png" 2>/dev/null
}

# Cuantas lineas ocupa la cabecera, para descontarlas al traducir un clic
alto_cabecera() {
  if [ "${TIPO:-txt}" = img ] && [ "$CABECERA" != oculta ]; then echo 1; return; fi
  case "$CABECERA" in
    oculta) echo 0 ;; compacta) echo 1 ;; minima) echo 2 ;; *) echo 3 ;;
  esac
}

render() {
  local txt
  txt=$(extraer_pagina "$PAG" | filtrar | sed '/^[[:space:]]*$/d')
  extraer_cursivas "$PAG" > "$TMP/cursivas"
  if [ "${#txt}" -lt 120 ]; then
    TIPO=img; : > "$TMP/pagina"; : > "$TMP/mapa"; RENGLONES=0; TOTLIN=0
  else
    TIPO=txt
    printf '%s\n' "$txt" | formatear > "$TMP/pagina"
    cargar_mapa
    RENGLONES=$(sort -n "$TMP/mapa" | tail -1); [ -z "$RENGLONES" ] && RENGLONES=0
    TOTLIN=$(wc -l < "$TMP/pagina")
  fi
  [ "$MARCA" -gt "$RENGLONES" ] && { MARCA=$RENGLONES; [ "$MARCA" -lt 1 ] && MARCA=1; }
  if [ "$GUIA" -eq 1 ]; then seguir_marca; else scroll_vista 0; fi
}

# Alto util: la ventana menos la cabecera, la linea en blanco y el prompt.
# Nunca se imprime mas que esto, asi el terminal no desplaza por su cuenta.
ayuda_actual() { if [ "${TIPO:-txt}" = img ]; then printf '%s' "$AYUDA_IMG"; else printf '%s' "$AYUDA"; fi; }

filas_ayuda() {
  local c n a
  a=$(ayuda_actual); c=$COLS; n=${#a}
  echo $(( (n + c - 1) / c ))
}

calcular_alto() {
  ALTO=$(( $LINEAS - $(alto_cabecera) - 1 - $(filas_ayuda) ))
  [ "$ALTO" -lt 5 ] && ALTO=5
}

# En que linea de la pagina empieza cada renglon. Se carga una vez por pagina:
# consultarlo con grep en cada giro de rueda costaba tres procesos por evento.
declare -A MAPA_LM
cargar_mapa() {
  local v n=0
  MAPA_LM=()
  while IFS= read -r v; do
    n=$(( n + 1 ))
    [ "$v" != 0 ] && [ -z "${MAPA_LM[$v]:-}" ] && MAPA_LM[$v]=$n
  done < "$TMP/mapa"
}

# Desplaza la vista lo justo para que el renglon marcado quede visible
seguir_marca() {
  local lm total
  lm="${MAPA_LM[$MARCA]:-}"
  [ -z "$lm" ] && return
  LM=$lm
  total=$TOTLIN
  calcular_alto
  [ "$lm" -lt "$VISTA" ] && VISTA=$lm
  [ "$lm" -gt $(( VISTA + ALTO - 1 )) ] && VISTA=$(( lm - ALTO + 1 ))
  [ "$VISTA" -gt $(( total - ALTO + 1 )) ] && VISTA=$(( total - ALTO + 1 ))
  [ "$VISTA" -lt 1 ] && VISTA=1
}

# Desplaza la vista tantas lineas como se indique, sin salirse de la pagina
scroll_vista() {
  local tope
  calcular_alto
  tope=$(( TOTLIN - ALTO + 1 )); [ "$tope" -lt 1 ] && tope=1
  VISTA=$(( VISTA + $1 ))
  [ "$VISTA" -gt "$tope" ] && VISTA=$tope
  [ "$VISTA" -lt 1 ] && VISTA=1
}

# Al encender la guia se respeta el renglon donde estaba, si sigue a la vista.
# Solo cuando se ha desplazado lejos con la guia apagada se recoloca en el
# primer renglon de lo que se esta viendo, que si no quedaria fuera de pantalla.
guia_al_reactivar() {
  local lm n
  calcular_alto
  lm="${MAPA_LM[$MARCA]:-}"
  if [ -n "$lm" ] && [ "$lm" -ge "$VISTA" ] && [ "$lm" -le $(( VISTA + ALTO - 1 )) ]; then
    seguir_marca; return
  fi
  n=$(sed -n "${VISTA},\$p" "$TMP/mapa" | grep -m1 -v '^0$')
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] && MARCA=$n
  seguir_marca
}

mostrar() {
  if [ "$TIPO" = img ]; then
    clear; cabecera "$PAG"; render_img "$PAG"; return
  fi
  calcular_alto
  { cabecera "$PAG"
    sed -n "${VISTA},$(( VISTA + ALTO - 1 ))p" "$TMP/pagina" \
      | awk -v lm="$([ "$GUIA" -eq 1 ] && echo "$LM" || echo 0)" \
            -v v="$VISTA" -v cm="$C_MRK" -v off="$C_OFF" -v estilo="$GUIA_ESTILO" '
          # Sin numeros la flecha ocupa sitio del margen izquierdo, nunca se
          # antepone: si se añadiera delante empujaria el texto y el renglon
          # marcado quedaria desalineado respecto a los demas.
          function flecha(ini, fin,   n) {
            if (match($0, /^ +/)) n = RLENGTH; else n = 0
            # Se coloca al final del margen, pegada al texto, ocupando el
            # sitio de los espacios para no desplazar el renglon.
            if      (n >= 2) $0 = substr($0, 1, n - 2) ini "▸ " fin substr($0, n + 1)
            else if (n == 1) $0 = ini "▸" fin substr($0, 2)
            else             $0 = ini "▸" fin $0
          }
          { if (v + NR - 1 != lm) { print; next }
            if (estilo == "marca") {
              # Solo el indicador: la flecha y, si se ven, los numeros
              if (sub(/│/, "▸")) sub(/\033\[[0-9;]*m/, cm)
              else flecha(cm, off)
              print
            } else {
              # El renglon entero con el color de la marca
              gsub(/\033\[[0-9;]*m/, "")
              if (!sub(/│/, "▸")) flecha("", "")
              print cm $0 off
            }
          }'
  } | sed 's/$/\x1b[K/' > "$TMP/vista.tmp"
  # Completar con lineas vacias para que la barra quede siempre a la misma altura
  local pintadas faltan
  pintadas=$(wc -l < "$TMP/vista.tmp")
  faltan=$(( ALTO + $(alto_cabecera) - pintadas ))
  while [ "$faltan" -gt 0 ]; do printf '\033[K\n' >> "$TMP/vista.tmp"; faltan=$(( faltan - 1 )); done

  # Todo el repintado va en una sola escritura y entre marcas de salida
  # sincronizada (DEC 2026): asi el terminal no refresca a medias y no se ve
  # el barrido del texto al desplazarse. Los terminales que no la soportan
  # ignoran las secuencias.
  { printf '\033[?2026h\033[H'
    cat "$TMP/vista.tmp"
    # La barra va dentro del mismo fotograma. Pintarla aparte, despues del
    # borrado, dejaba un instante con la pantalla a medias en cada repintado.
    if [ "$TIPO" = img ]; then printf '\033[2m%s\033[0m\033[J\033[?2026l' "$(ayuda_actual)"
    else printf '\n\033[2m%s\033[0m\033[J\033[?2026l' "$(ayuda_actual)"; fi
  } > "$TMP/vista"
  cat "$TMP/vista"
}

# Traduce la fila de pantalla donde se hizo clic al renglon que hay debajo.
# Si el texto desbordo la ventana, el terminal ya ha desplazado: se descuenta
# ese desplazamiento para saber que linea del documento se ve en esa fila.
fila_a_renglon() {
  local y=$1 cab idx r
  cab=$(alto_cabecera)
  idx=$(( VISTA + y - cab - 1 ))
  [ "$idx" -lt 1 ] && return 1
  r=$(sed -n "${idx}p" "$TMP/mapa")
  [[ "$r" =~ ^[0-9]+$ ]] && [ "$r" -gt 0 ] && { echo "$r"; return 0; }
  return 1
}

# Paginas que contienen una ilustracion. Se filtra por tamaño porque muchos
# PDF llevan logos o marcas de agua repetidos en todas las paginas: sin filtro
# saldrian las 242. El umbral son 500x500 px de area.
ilustraciones() {
  if [ ! -s "$IMGF" ]; then
    pdfimages -list "$F" 2>/dev/null \
      | awk 'NR>2 && $1 ~ /^[0-9]+$/ && $4*$5 >= 250000 { print $1"\t"$4"x"$5 }' \
      | sort -n -u -k1,1 > "$IMGF"
  fi
  cat "$IMGF"
}

buscar() {
  [ -f "$TXTF" ] || pdftotext -layout "$F" "$TXTF" 2>/dev/null
  awk -v RS='\f' -v q="$1" 'tolower($0) ~ tolower(q) { print NR }' "$TXTF" | head -20
}

# ── Entrada por teclas sueltas y raton ──────────────────────────────────────

# El terminal hace eco de lo que llega mientras el programa esta ocupado
# repintando: con el raton activo, los codigos de los eventos aparecian escritos
# en pantalla y descuadraban el texto. read -s no basta, porque solo suprime el
# eco durante la lectura, no entre una y otra.
STTY_PREV=""
modo_lector() {
  STTY_PREV=$(stty -g 2>/dev/null) || STTY_PREV=""
  stty -echo -icanon min 1 time 0 2>/dev/null || true
}
modo_normal() {
  if [ -n "$STTY_PREV" ]; then stty "$STTY_PREV" 2>/dev/null || true
  else stty echo icanon 2>/dev/null || true; fi
}

raton_on()  { [ "$RATON" -eq 1 ] && printf '\033[?1000h\033[?1006h'; }
raton_off() { printf '\033[?1006l\033[?1000l'; }
restaurar() { raton_off; modo_normal; printf '\033[?25h\033[?1049l'; }
# Al juntar rafagas, la ultima tecla puede procesarse sin que el bucle vuelva
# a pasar por el guardado: se vuelca tambien al salir.
guardar_pos() { [ -n "${POSF:-}" ] && printf '%s %s %s\n' "$PAG" "$MARCA" "$GUIA" > "$POSF"; return 0; }
trap 'volcar_conf; guardar_pos; rm -rf "$TMP"; restaurar' EXIT

# Lee una pulsacion. Deja el resultado en TECLA; si es del raton, ademas en
# MB (boton), MX/MY (columna y fila) y MT (M al pulsar, m al soltar).
# Con PDFTERM_LOG apuntando a un fichero se anota cada tecla recibida, para
# poder averiguar que llega cuando pasa algo raro. Sin la variable no hace nada.
registrar() { [ -n "${PDFTERM_LOG:-}" ] && printf '%s %s\n' "$(date +%H:%M:%S.%N | cut -c1-12)" "$*" >> "$PDFTERM_LOG"; return 0; }

leer_tecla() {
  local c d e sec rc espera="${1:-}"
  if [ -n "$espera" ]; then
    IFS= read -rsn1 -t "$espera" c || return 1
  else
    while :; do
      IFS= read -rsn1 -t 0.4 c; rc=$?
      [ "$rc" -eq 0 ] && break
      if [ "$rc" -gt 128 ]; then volcar_conf; continue; fi   # 0,4 s sin pulsar
      return 1                                               # fin de entrada
    done
  fi
  if [ "$c" != $'\033' ]; then TECLA="$c"; registrar "tecla [$c]"; return 0; fi

  # A partir de aqui viene una secuencia de escape y hay que leerla ENTERA.
  # Con un margen corto, un evento del raton se partia y sus bytes se leian
  # despues como teclas sueltas: en "\033[<65;20;10M" el '<' estrecha la
  # columna y el '0' alterna los numeros, y la pantalla se descuadraba. Por eso
  # el margen es amplio: los bytes de una secuencia llegan siempre juntos.
  IFS= read -rsn1 -t 1 d || { TECLA=esc; registrar "ESC suelto (sin segundo byte)"; return 0; }
  [ "$d" != "[" ] && { TECLA=esc; registrar "ESC+[$d] no reconocido"; return 0; }
  sec=""
  while IFS= read -rsn1 -t 1 e; do
    sec+="$e"
    case "$e" in [A-Za-z~]) break ;; esac
    [ "${#sec}" -gt 24 ] && break        # secuencia anomala: se descarta
  done
  case "$sec" in
    A) TECLA=arriba ;;  B) TECLA=abajo ;;
    C) TECLA=derecha ;; D) TECLA=izquierda ;;
    "<"*) if [[ "$sec" =~ ^\<([0-9]+)\;([0-9]+)\;([0-9]+)([Mm])$ ]]; then
            MB="${BASH_REMATCH[1]}"; MX="${BASH_REMATCH[2]}"
            MY="${BASH_REMATCH[3]}"; MT="${BASH_REMATCH[4]}"; TECLA=raton
          else TECLA=otra; fi ;;
    *) TECLA=otra ;;
  esac
  registrar "secuencia [$sec] -> $TECLA${MB:+ boton=$MB fila=$MY}"
}

# Pide una linea de texto. Suspende el raton para no capturar sus codigos.
pedir() {
  raton_off; modo_normal; printf '\033[?25h'
  printf '%s' "$1"; IFS= read -r RESP
  printf '\033[?25l'; modo_lector; raton_on
}

VISTA=1; ALTO=20; RENGLONES=0; LM=1; TIPO=txt; SALIR=0
paleta
modo_lector
consultar_celda || true
drenar_entrada
printf '\033[?1049h\033[2J\033[?25l'
raton_on
render

# Aplica la tecla ya leida. No repinta: de eso se encarga el bucle, que junta
# las rafagas de la rueda en un solo repintado.
procesar_tecla() {
  registrar "  procesa $TECLA (pag $PAG marca $MARCA)"
  case "$TECLA" in
  ' '|n|derecha) [ "$PAG" -lt "$TOTAL" ] && { PAG=$((PAG+1)); MARCA=1; VISTA=1; render; } ;;
  p|izquierda)   [ "$PAG" -gt 1 ]        && { PAG=$((PAG-1)); MARCA=1; VISTA=1; render; } ;;
  j|abajo)  if [ "$GUIA" -eq 1 ]; then
              [ "$MARCA" -lt "$RENGLONES" ] && { MARCA=$((MARCA+1)); seguir_marca; }
            else scroll_vista 1; fi ;;
  k|arriba) if [ "$GUIA" -eq 1 ]; then
              [ "$MARCA" -gt 1 ] && { MARCA=$((MARCA-1)); seguir_marca; }
            else scroll_vista -1; fi ;;
  L)  case "$GUIA_ESTILO" in marca) GUIA_ESTILO=linea ;; *) GUIA_ESTILO=marca ;; esac
      marcar_conf ;;
  l)  GUIA=$(( 1 - GUIA )); marcar_conf
      [ "$GUIA" -eq 1 ] && guia_al_reactivar ;;
  raton)
    case "$MB" in
      0)  [ "$GUIA" -eq 1 ] && [ "$MT" = "M" ] \
            && { r=$(fila_a_renglon "$MY") && { MARCA=$r; seguir_marca; }; } ;;
      64) if [ "$GUIA" -eq 1 ]; then
            [ "$MARCA" -gt 1 ] && { MARCA=$((MARCA-1)); seguir_marca; }
          else scroll_vista -3; fi ;;
      65) if [ "$GUIA" -eq 1 ]; then
            [ "$MARCA" -lt "$RENGLONES" ] && { MARCA=$((MARCA+1)); seguir_marca; }
          else scroll_vista 3; fi ;;
    esac ;;
  r)  RATON=$(( 1 - RATON )); marcar_conf
      if [ "$RATON" -eq 1 ]; then raton_on; else raton_off; fi ;;
  +)  INTER=$((INTER+1));     [ "$INTER" -gt 3 ]   && INTER=3;   marcar_conf; render ;;
  -)  INTER=$((INTER-1));     [ "$INTER" -lt 0 ]   && INTER=0;   marcar_conf; render ;;
  .)  PARRAFO=$((PARRAFO+1)); [ "$PARRAFO" -gt 6 ] && PARRAFO=6; marcar_conf; render ;;
  ,)  PARRAFO=$((PARRAFO-1)); [ "$PARRAFO" -lt 0 ] && PARRAFO=0; marcar_conf; render ;;
  '>') ANCHO=$((ANCHO+4));    [ "$ANCHO" -gt 120 ] && ANCHO=120; marcar_conf; render ;;
  '<') ANCHO=$((ANCHO-4));    [ "$ANCHO" -lt 40 ]  && ANCHO=40;  marcar_conf; render ;;
  '#'|0) NUM=$(( 1 - NUM )); marcar_conf; render ;;
  t)  case "$TEMA" in suave) TEMA=sepia;; sepia) TEMA=normal;; normal) TEMA=propio;; *) TEMA=suave;; esac
      paleta; marcar_conf; render ;;
  h)  case "$CABECERA" in completa) CABECERA=compacta;; compacta) CABECERA=minima;;
                          minima) CABECERA=oculta;; *) CABECERA=completa;; esac
      marcar_conf ;;
  g)  pedir "Ir a la página > "
      [[ "$RESP" =~ ^[0-9]+$ ]] && [ "$RESP" -ge 1 ] && [ "$RESP" -le "$TOTAL" ] \
        && { PAG=$RESP; MARCA=1; VISTA=1; render; } ;;
  i)  clear; render_img "$PAG" $(( $LINEAS - 2 )); pedir "Enter para volver > " ;;
  c)  CURSIVA=$(( 1 - CURSIVA )); marcar_conf; render ;;
  C)  COMILLAS=$(( 1 - COMILLAS )); marcar_conf; render ;;
  F)  case "$IMG_FORMATO" in
        auto)    IMG_FORMATO=sixels ;;
        sixels)  IMG_FORMATO=kitty ;;
        kitty)   IMG_FORMATO=iterm ;;
        iterm)   IMG_FORMATO=symbols ;;
        *)       IMG_FORMATO=auto ;;
      esac
      marcar_conf
      clear; printf 'Formato de imagen: \033[1m%s\033[0m\n\n' "$IMG_FORMATO"
      render_img "$PAG" $(( $LINEAS - 4 )); pedir $'\n''Enter para volver > ' ;;
  I)  clear
      res=$(ilustraciones)
      if [ -z "$res" ]; then
        pedir "Este PDF no tiene ilustraciones. Enter > "
      else
        printf '\033[1mPáginas con ilustración\033[0m  (%s en total)\n\n' "$(echo "$res" | wc -l)"
        echo "$res" | awk -v c=4 '
          { printf "  %4s \033[2m%-11s\033[0m", $1, $2
            if (NR % c == 0) printf "\n" }
          END { if (NR % c) printf "\n" }'
        pedir $'\n''Ir a la página > '
        [[ "$RESP" =~ ^[0-9]+$ ]] && [ "$RESP" -ge 1 ] && [ "$RESP" -le "$TOTAL" ] \
          && { PAG=$RESP; MARCA=1; VISTA=1; render; }
      fi ;;
  /)  pedir "Buscar > "
      if [ -n "$RESP" ]; then
        res=$(buscar "$RESP")
        clear
        if [ -z "$res" ]; then pedir "Sin resultados. Enter > "
        else echo "Páginas con «$RESP»:"; echo "$res" | tr '\n' ' '; echo
             pedir $'\n''Ir a la página > '
             [[ "$RESP" =~ ^[0-9]+$ ]] && [ "$RESP" -ge 1 ] && [ "$RESP" -le "$TOTAL" ] \
               && { PAG=$RESP; MARCA=1; VISTA=1; render; }
        fi
      fi ;;
  q)  clear; SALIR=1 ;;
  esac
}

while :; do
  mostrar; guardar_pos
  leer_tecla || break
  procesar_tecla
  [ "$SALIR" = 1 ] && break
  # Una vuelta de rueda manda varios eventos seguidos: se aplican todos y se
  # repinta una sola vez, en lugar de arrastrar un repintado por evento.
  while leer_tecla 0.01; do
    procesar_tecla
    [ "$SALIR" = 1 ] && break 2
  done
done
